---
import type { Locale } from '../../content/site';
import type { EverydayTool } from '../../lib/web-tools/everyday-contracts';
import { everydayCopy } from '../../content/everyday-copy';
import { webCopy } from '../../content/web-copy';
interface Props {locale: Locale; tool: EverydayTool}
const {locale, tool} = Astro.props;
const e = everydayCopy[locale], c = webCopy[locale];
const textSource = ['qrcode', 'text-cleanup', 'hash', 'regex', 'sql'].includes(tool);
---
<div class="wt-everyday" data-everyday={tool}>
  {tool === 'qrcode' && <><div class="wt-everyday-options"><label>{e.qrMode}<select data-option="qr-mode"><option value="generate">{e.qrGenerate}</option><option value="decode">{e.qrRead}</option></select></label><label data-file-control hidden>{e.chooseFile}<input type="file" data-option="file" accept="image/png,image/jpeg,image/webp" /></label></div><p>{e.qrNote}</p></>}
  {tool === 'hash' && <><div class="wt-everyday-options"><label>{e.mode}<select data-option="hash-mode"><option value="text">{e.text}</option><option value="file">{e.file}</option></select></label><label>{e.algorithm}<select data-option="algorithm"><option value="sha256">SHA-256</option><option value="sha512">SHA-512</option><option value="sha1">SHA-1</option><option value="md5">MD5</option></select></label><label data-file-control hidden>{e.chooseFile}<input type="file" data-option="file" /></label><label>{e.expected}<input data-option="expected" type="text" autocomplete="off" spellcheck="false" /></label></div><p>{e.weak}</p></>}
  {tool === 'text-cleanup' && <><div class="wt-everyday-options"><label><input type="checkbox" data-option="trim" />{e.trim}</label><label>{e.case}<select data-option="case"><option value="keep">{e.keep}</option><option value="lower">{e.lower}</option><option value="upper">{e.upper}</option></select></label><label><input type="checkbox" data-option="removeEmpty" />{e.removeEmpty}</label><label><input type="checkbox" data-option="deduplicate" checked />{e.deduplicate}</label><label>{e.sort}<select data-option="sort"><option value="none">{e.none}</option><option value="ascending">{e.ascending}</option><option value="descending">{e.descending}</option></select></label></div><p>{e.order}</p></>}
  {tool === 'regex' && <><div class="wt-everyday-options"><label class="wt-everyday-wide">{e.pattern}<input data-option="pattern" type="text" autocomplete="off" spellcheck="false" /></label><label>{e.flags}<input data-option="flags" type="text" value="g" autocomplete="off" spellcheck="false" /></label><label class="wt-everyday-wide">{e.replacement}<input data-option="replacement" type="text" value="$&" autocomplete="off" spellcheck="false" /></label></div><p>{e.offsets}</p></>}
  {tool === 'sql' && <><div class="wt-everyday-options"><label>{e.dialect}<select data-option="dialect"><option value="mysql">MySQL</option><option value="postgresql">PostgreSQL</option><option value="sqlite">SQLite</option></select></label></div><p>{e.sqlNote}</p></>}
  {tool === 'date-calculator' && <><div class="wt-everyday-options"><label>{e.action}<select data-option="date-action"><option value="difference">{e.difference}</option><option value="shift">{e.shift}</option></select></label><label>{e.start}<input data-option="start" type="text" placeholder="YYYY-MM-DD" inputmode="numeric" autocomplete="off" /></label><label data-date-end>{e.end}<input data-option="end" type="text" placeholder="YYYY-MM-DD" inputmode="numeric" autocomplete="off" /></label><label data-date-amount hidden>{e.amount}<input data-option="amount" type="number" value="1" min="-3652058" max="3652058" step="1" /></label><label><input data-option="weekends" type="checkbox" />{e.weekends}</label></div><p>{e.dateNote}</p></>}
  {tool === 'password' && <div class="wt-everyday-options"><label>{e.length}<input data-option="length" type="number" value="20" min="8" max="128" step="1" /></label><label>{e.count}<input data-option="count" type="number" value="1" min="1" max="100" step="1" /></label>{(['uppercase','lowercase','digits','symbols'] as const).map(key => <label><input data-option={key} type="checkbox" checked={key !== 'symbols'} />{e[key]}</label>)}</div>}
  {tool === 'cron' && <><div class="wt-everyday-options"><label>{e.cronMode}<select data-option="cron-mode"><option value="unix">Unix · 5</option><option value="spring">Spring · 6</option></select></label><label class="wt-everyday-wide">{e.expression}<input data-option="expression" type="text" value="0 9 * * *" autocomplete="off" spellcheck="false" /></label><label>{e.timezone}<input data-option="timezone" type="text" autocomplete="off" spellcheck="false" /></label><label class="wt-everyday-wide">{e.baseline}<input data-option="baseline" type="text" autocomplete="off" spellcheck="false" /></label><button type="button" data-use-now>{e.now}</button></div><p data-timezone-fallback hidden>{e.fallback}</p><p>{e.cronNote}</p></>}
  <div class:list={['wt-editor-columns', {'wt-everyday-result-only': !textSource}]}>
    {textSource && <div class="wt-editor-pane" data-source-control><label for="everyday-input">{c.source}</label><textarea id="everyday-input" data-source data-numbered spellcheck="false" autocomplete="off"></textarea></div>}
    <div class="wt-editor-pane"><label for="everyday-output">{c.output}</label><textarea id="everyday-output" data-output data-numbered readonly spellcheck="false" autocomplete="off"></textarea></div>
  </div>
  {tool === 'qrcode' && <figure class="wt-everyday-qr" data-qr-preview hidden><img data-qr-image alt={e.qrPreview} width="1024" height="1024" /></figure>}
  <div class="wt-actions"><button type="button" class="wt-primary" data-everyday-run="format">{tool === 'sql' ? e.format : tool === 'password' || tool === 'qrcode' ? e.generate : e.run}</button>{tool === 'sql' && <button type="button" data-everyday-run="compact">{e.compact}</button>}<button type="button" data-everyday-copy disabled>{c.copy}</button><button type="button" data-everyday-download disabled>{e.download}</button>{tool === 'qrcode' && <><button type="button" data-qr-png disabled>{e.png}</button><button type="button" data-qr-svg disabled>{e.svg}</button></>}<button type="button" data-clear>{c.clear}</button><button type="button" data-cancel hidden>{c.cancel}</button><button type="button" data-everyday-example>{e.example}</button></div>
  {tool === 'regex' && <section data-regex-results hidden aria-labelledby="regex-matches"><h2 id="regex-matches">{e.matches}</h2><p data-regex-summary></p><pre data-regex-captures tabindex="0"></pre><div class="wt-actions"><button type="button" data-regex-previous>{e.previous}</button><button type="button" data-regex-next>{e.next}</button></div><h3>{e.highlight}</h3><pre data-regex-highlight tabindex="0"></pre></section>}
  {tool === 'password' && <div data-password-list class="wt-password-list"></div>}
</div>
