---
import ImageWorkspace from './ImageWorkspace.astro';
import Feedback from './Feedback.astro';
import { getFeedbackConfiguration } from '../../lib/feedback/config';
import { siteOrigin } from '../../content/seo';
import TimestampWorkspace from './TimestampWorkspace.astro';
import MarkdownWorkspace from './MarkdownWorkspace.astro';
import UnicodeWorkspace from './UnicodeWorkspace.astro';
import DiffWorkspace from './DiffWorkspace.astro';
import Layout from '../../layouts/Layout.astro';
import { webCopy, webTools, webReviewedAt, webCategories, categoryLabels, type WebTool } from '../../content/web-tools';
import { guideCopy } from '../../content/web-tool-guides';
import { catalog, copy, path, type Locale } from '../../content/site';
import { toolSlugs } from '../../content/documentation';
import '../../styles/web-tools.css';
interface Props { locale: Locale; tool?: WebTool }
const { locale, tool } = Astro.props;
const c = webCopy[locale];
const categories = categoryLabels[locale];
const g = guideCopy[locale];
const details = webTools[locale].find((entry) => entry.slug === tool);
const page = tool ? `tools/${tool}` : 'tools';
const title = details?.title ?? c.directory;
const privacy = !tool ? c.directoryPrivacy : tool === 'markdown' ? c.markdownPrivacy : c.privacy;
const feedback = getFeedbackConfiguration({ ...process.env, SITE_PREVIEW: import.meta.env.SITE_PREVIEW, VERCEL_ENV: import.meta.env.VERCEL_ENV }, siteOrigin);
const available = catalog.packages.some((entry) => entry.profile === 'standard');
---
<Layout locale={locale} page={page} title={`${details?.guide.searchTitle ?? g.directoryTitle} | Zero`} description={details?.description ?? g.description} webTools frameOrigin={feedback?.origin}>
  <div class="wt container" data-web-tools data-locale={locale} data-tool={tool ?? 'directory'}>
    {!tool ? <>
      <header class="wt-bar wt-directory-bar">
        <div class="wt-directory-navigation">
          <h1>{c.directory}</h1>
          <div class="wt-category-controls" role="group" aria-label={locale === 'zh' ? '工具分类' : 'Tool category'} data-enhance-only hidden>
            {(['all', ...webCategories] as const).map((category) => <button type="button" data-category={category} aria-pressed={category === 'all' ? 'true' : 'false'}>{categories[category]}</button>)}
          </div>
        </div>
        <div class="wt-directory-settings" data-enhance-only hidden>
          <div class="wt-directory-search">
            <input type="search" data-directory-search aria-label={locale === 'zh' ? '在当前分类搜索' : 'Search current category'} placeholder={c.search} autocomplete="off" />
            <button type="button" data-open-search aria-label={locale === 'zh' ? '搜索全部工具' : 'Search all tools'} title={c.searchKeys}><kbd>{c.searchKeys}</kbd></button>
          </div>
          <select data-theme aria-label={c.theme}><option value="system">{c.system}</option><option value="light">{c.light}</option><option value="dark">{c.dark}</option></select>
        </div>
      </header>
      <p class="wt-local wt-directory-local">{c.local}</p>
    </> : <>
    <div class="wt-bar wt-detail-bar">
      <nav class="wt-breadcrumb" aria-label={locale === 'zh' ? '工具位置' : 'Tool location'}>
        <a href={path(locale, 'tools')}>{c.directory}</a>
        {details && <><span aria-hidden="true">-</span><a href={`${path(locale, 'tools')}?category=${details.category}`}>{categories[details.category]}</a></>}
      </nav>
      <div class="wt-settings" data-enhance-only hidden>
        <button type="button" data-open-search>{c.search}<kbd>{c.searchKeys}</kbd></button>
        <select data-theme aria-label={c.theme}><option value="system">{c.system}</option><option value="light">{c.light}</option><option value="dark">{c.dark}</option></select>
      </div>
    </div>
    <header class="wt-heading"><div class="wt-title-row"><h1>{title}</h1><p class="wt-local">{c.local}</p></div><p>{details?.description ?? g.description}</p></header>
    </>}
    <noscript><p class="wt-notice">{c.nojs}</p></noscript>
    {!tool ? <>
      <p data-directory-empty hidden>{locale === 'zh' ? '当前分类没有匹配工具。' : 'No tools match in this category.'} <button type="button" data-category-recover>{locale === 'zh' ? '搜索全部分类' : 'Search all categories'}</button></p>
      <div class="wt-directory">{webTools[locale].map((entry) => <a href={path(locale, `tools/${entry.slug}`)} class="wt-directory-row" data-directory-category={entry.category} data-directory-name={`${entry.slug} ${entry.title} ${entry.description}`}>
        <div class="wt-card-heading"><span class="wt-tool-symbol" aria-hidden="true">{{ timestamp: '↔', json: '{ }', base64: 'A/', diff: '±', unicode: 'U+', 'image-converter': '⇄', 'image-watermark': '©', 'image-compressor': '↓', markdown: 'M↓' }[entry.slug]}</span><h2>{entry.title}</h2><small>{categories[entry.category]}</small></div>
        <p>{entry.description}</p>
        <div class="wt-card-footer"><code>{entry.example}</code><span aria-hidden="true">↗</span></div>
      </a>)}</div>
      <section class="wt-guidance"><h2>{c.desktop}</h2><nav class="wt-desktop-links" aria-label={c.desktop}>{toolSlugs.map((slug) => <a href={path(locale, `tools/${slug}`)}>Zero {slug.charAt(0).toUpperCase() + slug.slice(1)} ↗</a>)}</nav><p>{c.directoryLimits}</p><p>{privacy}</p></section>
      <section class="wt-faq"><h2>{c.faq}</h2>{c.directoryFaq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
    </> : <>
      <fieldset class:list={["wt-workspace", { "wt-markdown-shell": tool === "markdown" }]} data-interactive disabled aria-label={title}>
        {tool === 'timestamp' ? <>
          <TimestampWorkspace locale={locale} />
        </> : tool === 'diff' ? <DiffWorkspace locale={locale} /> : tool === 'unicode' ? <UnicodeWorkspace locale={locale} /> : tool === 'markdown' ? <MarkdownWorkspace locale={locale} /> : (tool === 'image-converter' || tool === 'image-watermark' || tool === 'image-compressor') ? <ImageWorkspace locale={locale} tool={tool} /> : <>
          {tool === 'base64' && <div class="wt-codec-controls"><label>{c.mode}<select data-mode><option value="text">{c.text}</option><option value="url">{c.url}</option><option value="image">{c.image}</option></select></label><label data-file-label hidden>{c.file}<input type="file" data-file accept="image/png,image/jpeg,image/webp" /></label></div>}
          <div class="wt-editor-columns"><div class="wt-editor-pane"><div class="wt-pane-label"><label for="tool-input">{c.source}</label>{tool === 'json' && <button type="button" data-editor-enable>{c.enhance}</button>}</div><textarea id="tool-input" data-numbered data-source spellcheck="false" autocomplete="off" placeholder={details?.example}></textarea><div data-editor-host hidden></div></div><div class="wt-editor-pane"><label for="tool-output">{c.output}</label><textarea id="tool-output" data-numbered data-output readonly spellcheck="false" placeholder={c.ready}></textarea></div></div>
          <div class="wt-actions">
            {tool === 'json' ? (['format', 'compact', 'validate', 'unwrap'] as const).map((action, index) => <button class:list={{ 'wt-primary': index === 0 }} type="button" data-operation={action}>{c[action]}</button>) : <><button class="wt-primary" type="button" data-codec-action="encode">{c.encode}</button><button type="button" data-codec-action="decode">{c.decode}</button></>}
            <button type="button" data-copy-output disabled>{c.copy}</button><button type="button" data-clear>{c.clear}</button><button type="button" data-cancel hidden>{c.cancel}</button>
          </div>
          {tool === 'base64' && <figure class="wt-image" data-image-area hidden><img data-image-preview alt={c.preview} /><figcaption data-image-info></figcaption><a data-image-download class="wt-download" download>{c.download}</a></figure>}
        </>}
        <p class="wt-status" role="status" aria-live="polite" data-status>{c.ready}</p>
        <div data-manual-copy hidden><label for="manual-copy">{c.copyFailed}</label><textarea id="manual-copy" data-manual-value readonly></textarea></div>
      </fieldset>
      {details && <>
        <section class="wt-guidance" aria-labelledby="usage">
          <h2 id="usage">{c.guide}</h2>
          <h3 id="steps">{g.steps}</h3>
          <ol>{details.guide.steps.map((step) => <li>{step}</li>)}</ol>
          <h3 id="examples">{g.examples}</h3>
          {details.guide.examples.map((example) => <figure class="wt-example">
            <figcaption>{example.name}</figcaption>
            <dl><dt>{g.input}</dt><dd><pre><code>{example.input}</code></pre></dd><dt>{g.output}</dt><dd><pre><code>{example.output}</code></pre></dd></dl>
          </figure>)}
          {tool === 'markdown' && <p><a href={`${import.meta.env.BASE_URL}markdown-notices/THIRD-PARTY-NOTICES.txt`}>{locale === 'zh' ? 'Markdown、PDF 与中文字体的第三方许可及来源' : 'Markdown, PDF and Chinese font licenses and sources'}</a></p>}
          {details.category === 'image' && <p><a href={`${import.meta.env.BASE_URL}image-codecs/materials/THIRD_PARTY_NOTICES.md`}>{locale === 'zh' ? '图片编解码器许可、对应源码与 LGPL 使用、替换和重建权利' : 'Image codec licenses, corresponding source and LGPL usage, replacement and rebuild rights'}</a></p>}
          <h3>{g.limits}</h3><ul>{details.notes.map((note) => <li>{note}</li>)}</ul><p>{privacy}</p>
        </section>
        <section class="wt-guidance" aria-labelledby="agent-usage">
          <h2 id="agent-usage">{g.agent}</h2><p>{g.runtime}</p>
          <dl class="wt-agent"><dt>{g.agentInput}</dt><dd>{details.guide.agent.input}</dd><dt>{g.agentOutput}</dt><dd>{details.guide.agent.output}</dd></dl>
          <h3>{g.actions}</h3><ul>{details.guide.agent.actions.map((action) => <li>{action}</li>)}</ul><p>{g.execution}</p>
        </section>
      </>}
      <section class="wt-faq"><h2>{c.faq}</h2>{details?.faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
    </>}
    <Feedback locale={locale} thread={page} origin={feedback?.origin} />
    <p class="wt-reviewed">{c.reviewed}: <time datetime={webReviewedAt}>{webReviewedAt}</time></p>
    <aside class="wt-cta"><div><h2>{c.cta}</h2><p>{c.ctaText}</p><p class="wt-future">{c.future}</p></div><a class="wt-download" href={path(locale, 'download')}>{available ? copy[locale].acquisition.available : copy[locale].acquisition.unavailable} ↗</a></aside>
    <dialog class="wt-search" data-search-dialog aria-labelledby="search-title"><div class="wt-search-top"><h2 id="search-title">{c.search}</h2><button type="button" data-close-search aria-label={c.close}>×</button></div><label for="tool-search">{c.searchHint}</label><input type="search" id="tool-search" data-search-input autocomplete="off" /><nav aria-label={c.search} data-search-results>{webTools[locale].map((entry) => <a href={path(locale, `tools/${entry.slug}`)} data-search-name={`${entry.slug} ${entry.title} ${entry.description}`}>{entry.title}<span>{entry.description}</span></a>)}</nav><p data-search-empty hidden>{c.empty}</p></dialog>
  </div>
  <script>import '../../scripts/web-tools/page';</script>
</Layout>
