---
import Layout from '../layouts/Layout.astro';
import Preview from './Preview.astro';
import Tools from './Tools.astro';
import Icon from './Icon.astro';
import { copy, catalog, links, path, type Locale } from '../content/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy[locale];
const available = catalog.packages.some((entry) => entry.profile === 'standard');
const get = available ? c.acquisition.available : c.acquisition.unavailable;
---
<Layout locale={locale}>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="tiny-mark" aria-hidden="true"></span>{c.hero.eyebrow}</p>
      <h1 id="hero-title"><span>{c.hero.first}</span><span>{c.hero.second}</span></h1>
      <p class="hero-intro line-breaks">{c.hero.intro}</p>
      <div class="hero-actions"><a class="button primary" href={path(locale, 'download')}>{get}<span aria-hidden="true">↗</span></a><a class="text-link" href="#tools">{c.hero.secondary}<span aria-hidden="true">↓</span></a></div>
      <p class="hero-note">{c.hero.note}</p>
    </div>
    <div class="hero-preview"><Preview locale={locale} /></div>
  </section>
  <div class="hero-baseline container"><span class="mono">Ø / ZERO</span><span>Small tools. A bigger workspace.</span><span class="mono">SCROLL TO EXPLORE ↓</span></div>
  <section id="workflow" class="workflow-section container section-space" aria-labelledby="workflow-title">
    <p class="eyebrow">{c.workflow.eyebrow}</p>
    <div class="heading-columns"><h2 id="workflow-title" class="line-breaks">{c.workflow.title}</h2><p>{c.workflow.intro}</p></div>
    <div class="workflow-grid"><article><span class="workflow-symbol" aria-hidden="true">—</span><h3>{c.workflow.quick}</h3><p>{c.workflow.quickText}</p></article><div class="workflow-link" aria-hidden="true">↗</div><article><span class="workflow-symbol full-symbol" aria-hidden="true">↗</span><h3>{c.workflow.full}</h3><p>{c.workflow.fullText}</p></article></div>
    <p class="image-source">{c.workflow.caption}</p>
  </section>
  <Tools locale={locale} />
  <aside class="file-note container"><div class="file-note-mark" aria-hidden="true">＋</div><div><p class="eyebrow">{c.file.tag}</p><h2>{c.file.title}</h2><p>{c.file.text}</p></div><a class="text-link" href={links.github}>{c.file.link}<span aria-hidden="true">↗</span></a></aside>
  <section class="principles section-space" aria-labelledby="principles-title"><div class="container"><p class="eyebrow">{c.principles.eyebrow}</p><h2 id="principles-title" class="line-breaks">{c.principles.title}</h2><div class="principle-grid">{c.principles.items.map((item, index) => <article><span class="mono">0{index + 1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>
  <section class="faq-section container section-space" aria-labelledby="faq-title"><h2 id="faq-title">{c.faq.title}</h2><div class="faq-list">{c.faq.items.map((item, index) => <details><summary>{item.question}<span aria-hidden="true">＋</span></summary><p>{index === 0 && catalog.packages.length ? c.acquisition.releaseAnswer : item.answer}</p></details>)}</div></section>
  <section class="closing container"><Icon /><h2>{c.closing.title}</h2><p>{c.closing.text}</p><a class="button primary" href={path(locale, 'download')}>{get}<span aria-hidden="true">↗</span></a></section>
</Layout>
