{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "^/en/404(?:\\.html|/|/index\\.html)?$", "dest": "/en/404/index.html", "status": 404, "headers": { "X-Robots-Tag": "noindex, nofollow" } },
    { "src": "^/404(?:\\.html|/)?$", "dest": "/404.html", "status": 404, "headers": { "X-Robots-Tag": "noindex, nofollow" } },
    { "src": "^/llms(?:-full)?\\.txt$", "headers": { "X-Robots-Tag": "noindex", "Content-Type": "text/plain; charset=utf-8" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "^/en(?:/.*)?$", "dest": "/en/404/index.html", "status": 404, "headers": { "X-Robots-Tag": "noindex, nofollow" } },
    { "src": "^/.*$", "dest": "/404.html", "status": 404, "headers": { "X-Robots-Tag": "noindex, nofollow" } }
  ]
}
