{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "output",
    "test-results",
    "public/image-codecs"
  ],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true
  }
}
