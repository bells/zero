{
  "schemaVersion": 2,
  "name": "zero.snap",
  "id": "zero.snap",
  "displayName": "Snap",
  "description": "Capture and annotate on macOS, or open the Windows system screenshot tool.",
  "author": "Zero",
  "version": "0.1.0",
  "engines": {"zero": ">=0.2.0 <0.3.0", "api": "^1.0.0"},
  "platforms": ["macos", "windows"],
  "runtime": "webview",
  "main": "index.html",
  "permissions": ["screen.capture"],
  "requiredCapabilities": [{"id": "screen.capture", "version": "^1.0.0"}],
  "contributes": {"views": [
    {"id": "zero.snap.main", "title": "Snap", "surface": "main"},
    {"id": "zero.snap.tray", "title": "Snap", "surface": "tray"}
  ]},
  "activationEvents": ["onView:zero.snap.main", "onView:zero.snap.tray"]
}
