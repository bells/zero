{
  "schemaVersion": 2,
  "name": "zero.file",
  "id": "zero.file",
  "displayName": "File",
  "description": "Convert PDF and Word documents using the local File engine.",
  "author": "Zero",
  "version": "0.1.0",
  "engines": {"zero": ">=0.2.0 <0.3.0", "api": "^1.0.0"},
  "platforms": ["macos"],
  "runtime": "webview",
  "main": "index.html",
  "permissions": ["documents.convert"],
  "requiredCapabilities": [{"id": "documents.convert", "version": "^1.0.0"}],
  "contributes": {"views": [
    {"id": "zero.file.main", "title": "File", "surface": "main"},
    {"id": "zero.file.tray", "title": "File", "surface": "tray"}
  ]},
  "activationEvents": ["onView:zero.file.main", "onView:zero.file.tray"]
}
