{
  "schemaVersion": 2,
  "name": "zero.awake",
  "id": "zero.awake",
  "displayName": "Awake",
  "description": "Keep your computer awake with custom timing and battery protection.",
  "author": "Zero",
  "version": "0.1.0",
  "engines": {
    "zero": ">=0.2.0 <0.3.0",
    "api": "^1.0.0"
  },
  "platforms": [
    "macos",
    "windows"
  ],
  "runtime": "webview",
  "main": "index.html",
  "permissions": [
    "storage.plugin",
    "power.preventSleep"
  ],
  "requiredCapabilities": [
    {
      "id": "storage.plugin",
      "version": "^1.1.0"
    },
    {
      "id": "power.lease",
      "version": "^1.1.0"
    }
  ],
  "contributes": {
    "views": [
      {
        "id": "zero.awake.main",
        "title": "Awake",
        "surface": "main"
      },
      {
        "id": "zero.awake.tray",
        "title": "Awake",
        "surface": "tray"
      }
    ]
  },
  "activationEvents": [
    "onView:zero.awake.main",
    "onView:zero.awake.tray"
  ]
}
