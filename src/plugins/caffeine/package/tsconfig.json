{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@zero/sdk": [
        "../../../sdk/index.ts"
      ]
    }
  },
  "include": [
    "*.ts",
    "*.tsx"
  ]
}
