{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zero public Web plugin manifest v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zero": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "api": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        }
      },
      "required": [
        "zero",
        "api"
      ]
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "macos",
          "windows",
          "linux"
        ]
      },
      "maxItems": 3,
      "minItems": 1,
      "uniqueItems": true
    },
    "runtime": {
      "const": "webview"
    },
    "main": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "storage.plugin",
          "ui.message",
          "diagnostics.write",
          "network"
        ]
      },
      "maxItems": 3,
      "minItems": 0,
      "uniqueItems": true
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedOrigins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "maxItems": 32,
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "allowedOrigins"
      ]
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "\\S"
              },
              "surface": {
                "type": "string",
                "enum": [
                  "main",
                  "tray"
                ]
              }
            },
            "required": [
              "id",
              "title",
              "surface"
            ]
          },
          "maxItems": 8,
          "minItems": 1,
          "uniqueItems": true
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "\\S"
              },
              "viewId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "\\S"
              }
            },
            "required": [
              "id",
              "title",
              "viewId"
            ]
          },
          "maxItems": 64,
          "minItems": 0,
          "uniqueItems": true
        },
        "keybindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "\\S"
              },
              "default": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "\\S"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "\\S"
              }
            },
            "required": [
              "command",
              "default",
              "description"
            ]
          },
          "maxItems": 64,
          "minItems": 0,
          "uniqueItems": true
        },
        "statusBarItems": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "\\S"
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "\\S"
              },
              "icon": {
                "const": "extension"
              },
              "visibleByDefault": {
                "const": false
              }
            },
            "required": [
              "id",
              "title",
              "command",
              "icon",
              "visibleByDefault"
            ]
          },
          "maxItems": 8,
          "minItems": 0,
          "uniqueItems": true
        },
        "settings": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "\\S"
                  },
                  "type": {
                    "const": "boolean"
                  },
                  "default": {
                    "type": "boolean"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "key",
                  "type",
                  "default",
                  "label"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "\\S"
                  },
                  "type": {
                    "const": "string"
                  },
                  "default": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "key",
                  "type",
                  "default",
                  "label"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "\\S"
                  },
                  "type": {
                    "const": "number"
                  },
                  "default": {
                    "type": "number"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "key",
                  "type",
                  "default",
                  "label"
                ]
              }
            ]
          },
          "maxItems": 64,
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "views"
      ]
    },
    "activationEvents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "\\S"
      },
      "maxItems": 64,
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "id",
    "displayName",
    "description",
    "author",
    "version",
    "engines",
    "platforms",
    "runtime",
    "main",
    "permissions",
    "contributes",
    "activationEvents"
  ]
}
