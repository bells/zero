# Separate database/origins/secrets are mandatory for preview and production.
FEEDBACK_ENV=local
FEEDBACK_ORIGIN=http://127.0.0.1:4323
FEEDBACK_PARENT_ORIGINS=http://127.0.0.1:4321
# Local default is a synthetic in-memory database. Optional private local path:
# FEEDBACK_LOCAL_DATA=.data/local
# DATABASE_URL=postgresql://user:password@host/database
# Set independent random server-only values, at least 32 characters each:
# FEEDBACK_JWT_SECRET=
# FEEDBACK_SOURCE_SALT=
FEEDBACK_DAILY_WRITE_BUDGET=100
# Hosted writes remain paused until account/retention/deployment gates pass.
FEEDBACK_WRITES_PAUSED=1
FEEDBACK_QUALIFIED=0
# Used only by the controlled CLI, never by public registration:
# FEEDBACK_ADMIN_EMAIL=
# FEEDBACK_ADMIN_PASSWORD=
