{
  "name": "zero-feedback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-only",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-timeout=30000 tests/*.test.ts",
    "build": "pnpm check && vite build",
    "start": "node --experimental-strip-types server/local.ts",
    "init-admin": "node --experimental-strip-types scripts/init-admin.ts",
    "test:browser": "playwright test",
    "verify:client": "node scripts/audit-client.mjs",
    "purge": "node --experimental-strip-types scripts/purge.ts",
    "restore": "node --experimental-strip-types scripts/restore.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@waline/vercel": "1.43.4",
    "hono": "4.13.13",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "phpass": "1.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
